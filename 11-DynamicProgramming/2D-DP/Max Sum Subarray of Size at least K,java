class Solution {
    public int maxSumWithK(int[] arr, int k) {
        int n = arr.length;

        int[] maxEnd = new int[n];
        maxEnd[0] = arr[0];

        for (int i = 1; i < n; i++) {
            if (maxEnd[i - 1] > 0) {
                maxEnd[i] = maxEnd[i - 1] + arr[i];
            } else {
                maxEnd[i] = arr[i];
            }
        }

        int windowSum = 0;

        for (int i = 0; i < k; i++) {
            windowSum += arr[i];
        }

        int ans = windowSum;

        for (int i = k; i < n; i++) {
            windowSum += arr[i];
            windowSum -= arr[i - k];

            if (windowSum > ans) {
                ans = windowSum;
            }

            int extended = windowSum + maxEnd[i - k];

            if (extended > ans) {
                ans = extended;
            }
        }

        return ans;
    }
}
